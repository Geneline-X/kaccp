# KACCP environment configuration
#
# Copy to .env and fill in the values you need:
#
#   cp .env.example .env
#
# Only the REQUIRED block is needed to run KACCP. Everything below it is
# optional: each optional integration is a convenience that the platform runs
# without. A complete deployment is possible using only open-source components
# (PostgreSQL + local filesystem storage + manual transcription).

# =============================================================================
# REQUIRED
# =============================================================================

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/kaccp?schema=public"

# Secret used to sign session tokens. Generate a strong random value:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Public base URL of this deployment. Used in emails and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# STORAGE — where audio recordings are kept
# =============================================================================

# "local" writes to the filesystem and requires no cloud account — this is the
# fully open-source path, and the default for development.
# "gcs" uses Google Cloud Storage.
STORAGE_PROVIDER="local"

# Where local storage writes files. Only used when STORAGE_PROVIDER=local.
LOCAL_STORAGE_ROOT="./storage"

# --- Google Cloud Storage (only when STORAGE_PROVIDER=gcs) -------------------
# GCS_BUCKET="my-kaccp-bucket"
# Supply credentials by ONE of the following:
# GCS_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
# GCS_CREDENTIALS_JSON='{"type":"service_account", ...}'
# GCS_CREDENTIALS_B64="base64-encoded-service-account-json"
# If none are set, Application Default Credentials are used.

# =============================================================================
# FIRST ADMIN — seeded by `npm run seed:admin`
# =============================================================================

MASTER_ADMIN_EMAIL="admin@example.com"
MASTER_ADMIN_PASSWORD="change-me"
MASTER_ADMIN_NAME="Platform Admin"

# =============================================================================
# WORKFLOW TUNING (optional — sensible defaults shown)
# =============================================================================

# How long a transcriber holds a claimed recording before it returns to the queue.
ASSIGNMENT_MINUTES="15"

# How many recordings one transcriber may hold at once.
MAX_ACTIVE_ASSIGNMENTS="3"

# =============================================================================
# DATABASE POOLING (optional)
# =============================================================================
# Each API route runs as its own serverless process, so the connection budget is
# (concurrent routes x connection_limit x instances). Keep the limit low unless a
# server-side pooler (e.g. PgBouncer) sits in front of the database.

DB_CONNECTION_LIMIT="1"
DB_POOL_TIMEOUT="20"
DB_CONNECT_TIMEOUT="10"

# How long an authenticated user record is cached, in milliseconds. Reduces the
# most frequent query in the app. Lower = fresher, higher = fewer queries.
AUTH_CACHE_MS="15000"

# =============================================================================
# OPTIONAL — AI-assisted transcription
# =============================================================================
# Leave unset to run KACCP as a fully manual transcription workflow.
# Any OpenAI-compatible endpoint works (vLLM, Ollama, LocalAI, self-hosted Whisper).

# OPENAI_API_KEY="sk-..."

# External ASR gateway for pre-filling machine transcripts.
# KAY_X_ENABLED="false"
# ASR_GATEWAY_URL="https://asr.example.com"
# ASR_API_KEY=""

# =============================================================================
# OPTIONAL — UI translation
# =============================================================================
# Provider for translating interface strings. Omit to disable translation.
# Supported: "google" | "deepl" | "openai"

# TRANSLATION_PROVIDER="google"
# GOOGLE_TRANSLATE_API_KEY=""
# DEEPL_API_KEY=""
# DEEPL_API_FREE="true"

# =============================================================================
# OPTIONAL — transactional email (password reset, notifications)
# =============================================================================
# Omit to disable outbound email.

# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASS="app-specific-password"

# =============================================================================
# OPTIONAL — UploadThing browser upload helper
# =============================================================================
# Superseded by the storage abstraction above; not required.

# UPLOADTHING_TOKEN=""
# UPLOADTHING_SECRET=""
# UT_API_KEY=""
# UT_SECRET=""
